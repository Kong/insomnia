{
  "name": "restless-monorepo",
  "private": true,
  "version": "0.1.0",
  "author": "Outman",
  "description": "The local-first API client",
  "license": "Apache-2.0",
  "repository": "https://github.com/outmanos/restless",
  "bugs": {
    "url": "https://github.com/outmanos/restless/issues"
  },
  "homepage": "https://github.com/outmanos/restless#readme",
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.0.0"
  },
  "workspaces": [
    "packages/insomnia-testing",
    "packages/insomnia",
    "packages/insomnia-data",
    "packages/insomnia-inso",
    "packages/insomnia-smoke-test",
    "packages/insomnia-scripting-environment",
    "packages/restless-plugin-secret-managers"
  ],
  "scripts": {
    "dev": "npm start -w restless",
    "dev:autoRestart": "npm run start:autoRestart -w restless",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "git clean -dfX",
    "install-libcurl-electron": "electron-rebuild -f -w node-libcurl -m packages/insomnia",
    "install-libcurl-node": "npm rebuild node-libcurl --build-from-source",
    "inso-start": "npm start -w insomnia-inso",
    "inso-package": "npm run build -w insomnia-inso && npm run package -w insomnia-inso",
    "watch:app": "npm run build:electron-entrypoints -w restless && npm run start:dev-server -w restless",
    "app-build": "npm run build -w restless",
    "app-package": "npm run package -w restless",
    "test:smoke:dev": "npm run test:dev -w insomnia-smoke-test -- --project=Smoke",
    "test:smoke:build": "npm run test:build -w insomnia-smoke-test -- --project=Smoke",
    "test:smoke:package": "npm run test:package -w insomnia-smoke-test -- --project=Smoke",
    "test:crit:package": "npm run test:package -w insomnia-smoke-test -- --project=Critical",
    "test:crit:dev": "npm run test:dev -w insomnia-smoke-test -- --project=Critical",
    "postinstall": "patch-package && npm run install-libcurl-electron",
    "check-cycle-references": "node scripts/circular-references/check-cycle-references.mjs",
    "check-cycle-references:baseline": "node scripts/circular-references/check-cycle-references.mjs --update-baseline"
  },
  "devDependencies": {
    "@develohpanda/fluent-builder": "^2.1.2",
    "@eslint/js": "^9.23.0",
    "@types/chai": "^4.3.14",
    "@types/har-format": "^1.2.15",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.25.10",
    "esbuild-runner": "^2.2.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "patch-package": "^8.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tslib": "2.0.1",
    "type-fest": "^4.15.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.2.4",
    "@electron/rebuild": "^4.0.0"
  },
  "overrides": {
    "ajv-draft-04": {
      "ajv": "$ajv"
    },
    "jshint": {
      "lodash": "4.18.1"
    },
    "lodash.set": "file:./scripts/shims/lodash.set",
    "node-abi": "^4.40.0",
    "form-data": "^4.0.6",
    "minimatch@<4": "^3.1.5",
    "minimatch@>=5 <6": "^5.1.9",
    "minimatch@>=7 <8": "^7.4.9",
    "minimatch@>=8 <9": "^8.0.7",
    "minimatch@>=9 <10": "^9.0.9",
    "minimatch@>=10 <11": "^10.1.1",
    "serialize-javascript": "^7.1.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "node-libcurl": "5.1.2"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.5": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "node-libcurl": true
  }
}
