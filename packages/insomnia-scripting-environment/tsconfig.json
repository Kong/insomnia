{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    /* Base Options: */
    "target": "es2022",
    "allowJs": true,
    "module": "ES2022",
    "noEmit": true,
    "paths": {
      "~/*": ["../../apps/desktop/src/*"]
    },
    "verbatimModuleSyntax": true,
    "jsx": "react",
    /* If your code runs in the DOM: */
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": ["../../apps/desktop/types"],
  "exclude": ["**/__tests__", "node_modules"]
}
