{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "module": "ES2022",
    "moduleResolution": "node",
    "isolatedModules": true,
    "jsx": "preserve",
    /* If your code runs in the DOM: */
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    /* Strictness https://github.com/tsconfig/bases/blob/main/bases/strictest.json */
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    // "exactOptionalPropertyTypes": true, TODO: max strictness
    "noFallthroughCasesInSwitch": true,
    // "noImplicitOverride": true, TODO:  max strictness
    "noImplicitReturns": true,
    // "noPropertyAccessFromIndexSignature": true, TODO:  max strictness
    // "noUncheckedIndexedAccess": true, TODO:  max strictness
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "../insomnia/types"
  ],
  "exclude": [
    "**/__tests__",
    "node_modules"
  ]
}
