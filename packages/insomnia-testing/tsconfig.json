{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    /* If NOT transpiling with TypeScript: */
    "module": "preserve",
    "noEmit": true,
    /* If your code runs in the DOM: */
    "lib": [
      "es2022",
    ],
    /* Strictness https://github.com/tsconfig/bases/blob/main/bases/strictest.json */
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    // "exactOptionalPropertyTypes": true, TODO: max strictness
    "noFallthroughCasesInSwitch": true,
    // "noImplicitOverride": true, TODO:  max strictness
    "noImplicitReturns": true,
    // "noPropertyAccessFromIndexSignature": true, TODO:  max strictness
    // "noUncheckedIndexedAccess": true, TODO:  max strictness
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": false
  }
}
