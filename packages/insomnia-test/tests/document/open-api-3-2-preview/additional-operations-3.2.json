{
  "openapi": "3.2.0",
  "info": { "title": "Petstore", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "query": {
        "summary": "Search pets",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "name": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "additionalOperations": {
        "PURGE": {
          "summary": "Purge pet cache",
          "responses": { "204": { "description": "No Content" } }
        },
        "LINK": {
          "summary": "Link pets",
          "responses": { "204": { "description": "No Content" } }
        }
      }
    }
  }
}
