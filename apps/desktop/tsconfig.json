{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    /* Basic */
    "target": "es2020",
    "allowJs": true,
    "noEmit": true,
    /* Transpiling Options */
    "module": "ESNext",
    "sourceMap": true,
    /* import resolution */
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./src/*"]
    },
    /* Runs in the DOM */
    "lib": ["ES2023", "DOM.Iterable", "DOM"],
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["types/global.d.ts", "**/*", ".react-router/types/**/*"],
  "exclude": [
    "./src/__mocks__/@getinsomnia/node-libcurl.ts",
    "**/__mocks__",
    "**/__snapshots__",
    "**/*.min.js",
    "assets",
    "bin",
    "build",
    "dist",
    "config",
    "node_modules",
    "src/coverage",
    "svgr.config.js"
  ]
}
