{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    /* Basic */
    "target": "es2022",
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "~/*": ["../desktop/src/*"]
    },
    /* Transpiling Options */
    "module": "ESNext",
    "sourceMap": true,
    "lib": ["ES2023", "DOM.Iterable"]
  },
  "include": ["esbuild.ts", "package.json", "src", "../desktop/types"],
  "exclude": [
    "**/*.test.ts",
    "**/__mocks__/*",
    "**/__snapshots__/**",
    "assets",
    "bin",
    "dist",
    "node_modules",
    "scripts",
    "src/vitest"
  ]
}
